# Database values come from Neon: run `neon env pull` to write them to .env.local.
# Put the rest here in .env (both files are git-ignored).

# Six-digit PINs; they must differ
STAFF_PIN=
AGENCY_PIN=

# Random, 32+ characters: openssl rand -hex 32
SESSION_SECRET=

# Optional: enables paste-to-log and the weekly summary
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-haiku-5-5)
# CLAUDE_MODEL=
