# Neon pooled connection string (host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Six-digit PINs; they must differ
STAFF_PIN=
AGENCY_PIN=

# Random, 32+ characters: openssl rand -hex 32
SESSION_SECRET=

# Optional: enables paste-to-log and the weekly summary
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-haiku-5-5)
# CLAUDE_MODEL=
